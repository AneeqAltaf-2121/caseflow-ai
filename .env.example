# ============================================
# CaseFlow AI
# Local development configuration
# ============================================

# Application
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://caseflow:caseflow@localhost:5432/caseflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# AI providers
OPENAI_API_KEY=

# AWS - production/deployment later
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=