# ============================================
# CaseFlow AI
# Local development configuration
# ============================================

# Application
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://caseflow:caseflow@localhost:5432/caseflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# The frontend's OAuth callback page, not a backend route — see
# apps/web/app/login/callback and app/config.py's comment on this setting.
OAUTH_REDIRECT_URL=http://localhost:3000/login/callback
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30
# Lets local dev/tests log in via /auth/mock/login with no real IdP.
# Always false outside development regardless of this flag.
ALLOW_MOCK_OAUTH=true

# AI providers
# "mock" needs no key and is the default so the app runs without credentials.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Object storage
# "local" writes under ./storage; "s3" uses the AWS_* settings below.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# AWS - production/deployment (see infra/aws)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=